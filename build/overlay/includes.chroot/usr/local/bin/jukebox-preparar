#!/usr/bin/env python3
# Gera /opt/jukebox/biblioteca.js só com o que está gravado no sistema/ISO.
# Pendrives e HDs são escolhidos pela tela Configurações > Bibliotecas.
import os, sys, json
ROOT = sys.argv[1] if len(sys.argv) > 1 else '/opt/jukebox'
EXT = {'.mp3','.wav','.ogg','.oga','.m4a','.aac','.flac','.opus','.wma','.mp4','.m4v','.webm','.mkv','.mov','.avi',
       '.mpg','.mpeg','.3gp','.ogv','.wmv','.jpg','.jpeg','.png','.webp','.gif','.bmp'}
lista = []
for dp, dns, fns in os.walk(ROOT, followlinks=True):
    dns[:] = [x for x in dns if not x.startswith('.') and not x.startswith('fonte-') and not (dp == ROOT and x == 'som')]
    for fn in fns:
        if not fn.startswith('.') and os.path.splitext(fn)[1].lower() in EXT:
            lista.append(os.path.relpath(os.path.join(dp, fn), ROOT).replace(os.sep, '/'))
lista.sort()
tmp = os.path.join(ROOT, 'biblioteca.js.tmp')
with open(tmp, 'w', encoding='utf-8') as f:
    f.write('window.BIBLIOTECA=' + json.dumps(lista, ensure_ascii=False, indent=4) + ';')
os.replace(tmp, os.path.join(ROOT, 'biblioteca.js'))
os.chmod(os.path.join(ROOT, 'biblioteca.js'), 0o644)
print('Pronto! %d arquivos' % len(lista))
